{
  "manifestVersion": 1,
  "id": "kids-chores",
  "name": "Kids Chores",
  "version": "1.0.9",
  "description": "A household chore list for children. Chores can include every member, or skip some, and the same account stays in sync across devices.",
  "entry": "index.js",
  "style": "style.css",
  "icon": "sparkles",
  "accent": "#EA580C",
  "settings": {
    "entry": "settings.js",
    "sections": ["household"],
    "labelKey": "settings.title"
  },
  "menu": {
    "show": true,
    "labelKey": "menu",
    "icon": "sparkles",
    "order": 55
  },
  "page": {
    "composition": "dashboard",
    "width": "wide",
    "navigation": "standard",
    "responsive": "standard"
  },
  "i18n": {
    "defaultLocale": "en"
  },
  "capabilities": {
    "permissions": {
      "module": {
        "label": "Kids Chores",
        "labelKey": "module",
        "icon": "sparkles"
      },
      "widgets": [
        {
          "id": "today",
          "label": "Kids Chores",
          "labelKey": "widgets.today"
        }
      ]
    },
    "widgets": [
      {
        "id": "today",
        "entry": "widgets/today.js",
        "label": "Kids Chores",
        "labelKey": "widgets.today",
        "icon": "sparkles",
        "defaultSize": "2x2",
        "defaultVisible": true
      }
    ],
    "api": {
      "prefix": "/api/extensions/kids-chores"
    }
  }
}
