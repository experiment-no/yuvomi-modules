{
  "manifestVersion": 1,
  "id": "met-weather",
  "name": "Weather",
  "version": "1.2.0",
  "description": "Værdata fra Norsk meteorologisk institutt",
  "entry": "index.js",
  "style": "style.css",
  "icon": "cloud-sun",
  "accent": "#0369A1",
  "settings": {
    "entry": "settings.js",
    "sections": ["household"],
    "labelKey": "settings.title"
  },
  "menu": {
    "show": true,
    "labelKey": "menu",
    "icon": "cloud-sun",
    "order": 56
  },
  "page": {
    "composition": "dashboard",
    "width": "wide",
    "navigation": "standard",
    "responsive": "standard"
  },
  "i18n": {
    "defaultLocale": "en"
  },
  "capabilities": {
    "permissions": {
      "module": {
        "label": "Weather",
        "labelKey": "module",
        "icon": "cloud-sun"
      },
      "widgets": [
        {
          "id": "forecast",
          "label": "Weather",
          "labelKey": "widgets.forecast"
        }
      ]
    },
    "widgets": [
      {
        "id": "forecast",
        "entry": "widgets/forecast.js",
        "label": "Weather",
        "labelKey": "widgets.forecast",
        "icon": "cloud-sun",
        "defaultSize": "4x2",
        "defaultVisible": true
      }
    ],
    "api": {
      "prefix": "/api/extensions/met-weather"
    }
  }
}
